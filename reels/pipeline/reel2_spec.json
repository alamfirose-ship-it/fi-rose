  {
   "s": 59.68,
   "e": 62.12,
   "t": "খরচও ব্রিটেন আদায় করেছিল জাঞ্জিবারের"
  },
  {
   "s": 62.12,
   "e": 63.04,
   "t": "কাছ থেকেই!"
