 "captions": [
  {
   "s": 0.08,
   "e": 2.16,
   "t": "ইতিহাসের সবচেয়ে ছোট যুদ্ধ"
  },
  {
   "s": 2.16,
   "e": 5.21,
   "t": "চলেছিল মাত্র আটত্রিশ মিনিট!"
  },
  {
   "s": 5.568,
   "e": 6.6,
   "t": "এক কাপ চা ঠান্ডা"
  },
  {
   "s": 6.6,
   "e": 8.97,
   "t": "হওয়ার আগেই যুদ্ধ শেষ।"
  },
  {
   "s": 9.28,
   "e": 11.16,
   "t": "১৮৯৬ সাল।"
  },
  {
   "s": 11.16,
   "e": 13.8,
   "t": "পূর্ব আফ্রিকার দ্বীপরাজ্য জাঞ্জিবার।"
  },
  {
   "s": 13.8,
   "e": 15.36,
   "t": "২৫ আগস্ট হঠাৎ মারা"
  },
  {
   "s": 15.36,
   "e": 16.88,
   "t": "গেলেন সুলতান হামাদ।"
  },
  {
   "s": 16.88,
   "e": 18.64,
   "t": "আর ব্রিটিশদের অনুমতি ছাড়াই"
  },
  {
   "s": 18.64,
   "e": 20.24,
   "t": "সিংহাসনে বসে গেলেন তাঁর"
  },
  {
   "s": 20.24,
   "e": 22.0,
   "t": "চাচাতো ভাই খালিদ।"
  },
  {
   "s": 22.0,
   "e": 24.16,
   "t": "ব্রিটিশরা আলটিমেটাম দিল, ২৭"
  },
  {
   "s": 24.16,
   "e": 25.84,
   "t": "আগস্ট সকাল নয়টার মধ্যে"
  },
  {
   "s": 25.84,
   "e": 27.16,
   "t": "প্রাসাদ ছাড়তে হবে।"
  },
  {
   "s": 27.16,
   "e": 28.76,
   "t": "খালিদ রাজি হলেন না।"
  },
  {
   "s": 28.76,
   "e": 30.24,
   "t": "প্রাসাদ ঘিরে দাঁড়াল প্রায়"
  },
  {
   "s": 30.24,
   "e": 32.010000000000005,
   "t": "তিন হাজার সৈন্য।"
  },
  {
   "s": 32.08,
   "e": 34.24,
   "t": "ঘড়িতে নয়টা বেজে দুই মিনিট।"
  },
  {
   "s": 34.24,
   "e": 35.56,
   "t": "ব্রিটিশ যুদ্ধজাহাজ থেকে"
  },
  {
   "s": 35.56,
   "e": 37.16,
   "t": "শুরু হলো গোলাবর্ষণ!"
  },
  {
   "s": 37.16,
   "e": 39.36,
   "t": "কাঠের প্রাসাদ মুহূর্তে জ্বলে উঠল,"
  },
  {
   "s": 39.36,
   "e": 41.44,
   "t": "ডুবে গেল সুলতানের জাহাজ।"
  },
  {
   "s": 41.44,
   "e": 42.8,
   "t": "নয়টা চল্লিশ।"
  },
  {
   "s": 42.8,
   "e": 44.8,
   "t": "প্রাসাদের পতাকা নেমে গেল।"
  },
  {
   "s": 44.8,
   "e": 46.08,
   "t": "যুদ্ধ শেষ।"
  },
  {
   "s": 46.08,
   "e": 47.52,
   "t": "জাঞ্জিবারের প্রায় পাঁচশো"
  },
  {
   "s": 47.52,
   "e": 48.96,
   "t": "মানুষ হতাহত হলেন।"
  },
  {
   "s": 48.96,
   "e": 50.68,
   "t": "ব্রিটিশদের পক্ষে আহত হলেন"
  },
  {
   "s": 50.68,
   "e": 52.32,
   "t": "মাত্র একজন নাবিক।"
  },
  {
   "s": 52.32,
   "e": 53.173,
   "t": "আর খালিদ?"
  },
  {
   "s": 53.173,
   "e": 55.6,
   "t": "পালিয়ে আশ্রয় নিলেন জার্মান কনস্যুলেটে।"
  },
  {
   "s": 55.6,
   "e": 57.68,
   "t": "আর সবচেয়ে অবাক করা ব্যাপার"
  },
  {
   "s": 57.68,
   "e": 59.68,
   "t": "বলা হয়, যুদ্ধে ছোড়া গোলার"
