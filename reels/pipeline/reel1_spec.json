 "captions": [
  {
   "s": 0.08,
   "e": 1.69,
   "t": "একজন মানুষ।"
  },
  {
   "s": 1.76,
   "e": 3.53,
   "t": "দুইটা পারমাণবিক বোমা।"
  },
  {
   "s": 4.0,
   "e": 7.17,
   "t": "আর তিনি দুইবারই বেঁচে ফিরেছিলেন।"
  },
  {
   "s": 7.2,
   "e": 9.97,
   "t": "১৯৪৫ সালের ৬ আগস্ট।"
  },
  {
   "s": 10.0,
   "e": 11.76,
   "t": "জাপানের হিরোশিমা।"
  },
  {
   "s": 11.76,
   "e": 14.08,
   "t": "অফিসের কাজে শহরে এসেছিলেন উনত্রিশ"
  },
  {
   "s": 14.08,
   "e": 16.96,
   "t": "বছরের প্রকৌশলী সুতোমু ইয়ামাগুচি।"
  },
  {
   "s": 16.96,
   "e": 19.68,
   "t": "সকাল সোয়া আটটায় হঠাৎ পুরো"
  },
  {
   "s": 19.68,
   "e": 21.28,
   "t": "আকাশ সাদা হয়ে গেল।"
  },
  {
   "s": 21.28,
   "e": 23.48,
   "t": "মাত্র তিন কিলোমিটার দূরে পড়েছিল"
  },
  {
   "s": 23.48,
   "e": 26.0,
   "t": "পৃথিবীর প্রথম পারমাণবিক বোমা।"
  },
  {
   "s": 26.0,
   "e": 27.92,
   "t": "তাঁর কানের পর্দা ফেটে যায়,"
  },
  {
   "s": 27.92,
   "e": 30.08,
   "t": "শরীরের একপাশ পুড়ে যায়।"
  },
  {
   "s": 30.08,
   "e": 32.309,
   "t": "তবুও তিনি বেঁচে যান।"
  },
  {
   "s": 32.309,
   "e": 34.16,
   "t": "পোড়া শরীর নিয়ে ট্রেনে চড়ে"
  },
  {
   "s": 34.16,
   "e": 36.24,
   "t": "তিনি ফিরে গেলেন নিজের শহরে।"
  },
  {
   "s": 36.24,
   "e": 38.41,
   "t": "শহরটার নাম নাগাসাকি।"
  },
  {
   "s": 38.784,
   "e": 39.92,
   "t": "৯ আগস্ট।"
  },
  {
   "s": 39.92,
   "e": 41.76,
   "t": "ব্যান্ডেজ জড়ানো শরীরে অফিসে"
  },
  {
   "s": 41.76,
   "e": 43.76,
   "t": "বসে তিনি বসকে হিরোশিমার"
  },
  {
   "s": 43.76,
   "e": 45.52,
   "t": "ভয়াবহতার কথা বলছিলেন।"
  },
  {
   "s": 45.52,
   "e": 47.6,
   "t": "ঠিক তখনই জানালায় আবার"
  },
  {
   "s": 47.6,
   "e": 48.72,
   "t": "সেই সাদা আলো।"
  },
  {
   "s": 48.72,
   "e": 51.04,
   "t": "আবারও প্রায় তিন কিলোমিটার দূরে।"
  },
  {
   "s": 51.04,
   "e": 53.12,
   "t": "আবারও বেঁচে গেলেন তিনি।"
  },
  {
   "s": 53.12,
   "e": 55.44,
   "t": "২০০৯ সালে জাপান সরকার তাঁকে"
  },
  {
   "s": 55.44,
   "e": 57.08,
   "t": "দুই বোমা থেকেই বেঁচে ফেরা"
  },
  {
   "s": 57.08,
   "e": 58.88,
   "t": "মানুষ হিসেবে স্বীকৃতি দেয়।"
  },
  {
   "s": 58.88,
   "e": 61.707,
   "t": "২০১০ সালে, তিরানব্বই বছর বয়সে,"
  },
  {
   "s": 61.707,
   "e": 63.267,
   "t": "তিনি পৃথিবী ছেড়ে যান।"
  },
  {
   "s": 63.267,
   "e": 65.013,
   "t": "এটা কি শুধুই ভাগ্য"
  },
  {
   "s": 65.013,
   "e": 66.36,
   "t": "নাকি অন্য কিছু?"
  },
  {
   "s": 66.36,
   "e": 68.8,
   "t": "কমেন্টে আপনার মত লিখুন।"
  }
 ],
